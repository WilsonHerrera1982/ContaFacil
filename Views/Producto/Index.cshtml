@model IEnumerable<ContaFacil.Models.Producto>

@{
    ViewData["Title"] = "Index";
}
<style>
    .table-danger {
        background-color: #f8d7da !important;
    }

    .badge-danger {
        background-color: #dc3545;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        margin-left: 5px;
    }
</style>
<p>
   
</p>
<div class="text-left mb-4">
    <h2>Gestiona Producto</h2>
    <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 mb-2" style="padding: 8px 16px; border-radius: 4px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
            <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13A6 6 0 1 1 8 2a6 6 0 0 1 0 12z"/>
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Crear Nuevo
    </a>
    <form asp-action="ExportToExcel" method="post" style="display:inline;">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </form>
    <a asp-action="Index" asp-controller="Inventario" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>
<table class="table" id="tblProducto">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Codigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Iva)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comision)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioVenta)
            </th>
           
            <th>
                Descuento%
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoBoolean)
            </th>
            <th>
                Categoría
            </th>
            <th>
                Unidad de Medida
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CantidadMinima)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Stock <= item.CantidadMinima ? "table-danger" : "")">
                <td>
                    @Html.DisplayFor(modelItem => item.Codigo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                    @if (item.Stock <= item.CantidadMinima)
                    {
                        <span class="badge badge-danger">¡Por agotarse!</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PrecioUnitario)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Iva)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Comision)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PrecioVenta)
                </td>
                <td>
                    @item.Descuento %
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Stock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EstadoBoolean)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdCategoriaProductoNavigation.Descripcion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdUnidadMedidaNavigation.Abreviatura)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CantidadMinima)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdProducto" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='currentColor' viewBox='0 0 16 16'><path d='M12.146 3.354a.5.5 0 0 1 .708 0l.792.792a.5.5 0 0 1 0 .708l-7.439 7.439-2.853.714a.25.25 0 0 1-.316-.316l.714-2.853 7.439-7.439zm1.061-1.061a1.5 1.5 0 0 0-2.122 0l-7.439 7.439a1.5 1.5 0 0 0-.378.63l-.714 2.853a1.25 1.25 0 0 0 1.58 1.58l2.853-.714a1.5 1.5 0 0 0 .63-.378l7.439-7.439a1.5 1.5 0 0 0 0-2.122l-.792-.792z'/></svg> Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdProducto" class="btn d-inline-flex align-items-center gap-2" style="background-color: #17a2b8; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='currentColor' viewBox='0 0 16 16'><path d='M10.442 10.442a1 1 0 0 1 1.415 0l3.85 3.85a1 1 0 0 1-1.415 1.415l-3.85-3.85a1 1 0 0 1 0-1.415z'/><path d='M6.5 12a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11zm0-1a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9z'/></svg> Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdProducto" class="btn d-inline-flex align-items-center gap-2" style="background-color: #dc3545; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='currentColor' viewBox='0 0 16 16'><path d='M5.5 5.5a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0v-6a.5.5 0 0 1 .5-.5zm5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0v-6a.5.5 0 0 1 .5-.5z'/><path fill-rule='evenodd' d='M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2h3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3a1 1 0 0 1 1 1zm-11 1v9a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4h-8zM4.118 2.5A.5.5 0 0 1 4.5 2h7a.5.5 0 0 1 .382.823l-3.5 4.5a.5.5 0 0 1-.764 0l-3.5-4.5A.5.5 0 0 1 4.118 2.5z'/></svg> Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts{
    <script>
$(document).ready(function() {
    $('form[asp-action="ExportToExcel"]').submit(function() {
        if (typeof showLoading === 'function') showLoading();
    });
});
</script>    
    <script src="~/js/jquery-3.6.0.js"></script>
    <script src="~/js/jquery-3.6.0.min.js"></script>
    <script src="~/js/DataTables/datatables.min.js"></script>
    <script type="text/javascript" src="~/js/bootstrap.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/bs4/jszip-2.5.0/dt-1.10.20/b-1.6.1/b-colvis-1.6.1/b-html5-1.6.1/b-print-1.6.1/r-2.2.3/datatables.min.css" />
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/v/bs4/jszip-2.5.0/dt-1.10.20/b-1.6.1/b-colvis-1.6.1/b-html5-1.6.1/b-print-1.6.1/r-2.2.3/datatables.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}