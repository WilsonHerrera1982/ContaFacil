@* Views/ConstatacionFisica/Nueva.cshtml *@
@model IEnumerable<ContaFacil.Models.ViewModel.ConstatacionFisicaViewModel>

<div class="container-fluid">
    <h2>Nueva Constatación Física</h2>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar por código o nombre..."
                           value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-4">
                    <button type="button" id="btnBuscar" class="btn btn-primary">Buscar</button>
                </div>
            </div>
        </div>
    </div>

    <form id="constatacionForm">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Stock Actual</th>
                        <th>Cantidad Física</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Codigo</td>
                            <td>@item.Nombre</td>
                            <td>@item.StockActual</td>
                            <td>
                                <input type="number" class="form-control cantidad-fisica"
                                       data-producto-id="@item.ProductoId" />
                            </td>
                            <td>
                                <input type="text" class="form-control descripcion"
                                       data-producto-id="@item.ProductoId" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Nueva", new { pagina = i, searchTerm = ViewBag.SearchTerm })">@i</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="mt-3">
            <button type="button" id="btnGuardar" class="btn btn-success">Guardar Constatación</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#btnBuscar').click(function () {
                var searchTerm = $('#searchInput').val();
                window.location.href = '@Url.Action("Nueva")?searchTerm=' + encodeURIComponent(searchTerm);
            });

            $('#btnGuardar').click(function () {
                var constataciones = [];
                $('.cantidad-fisica').each(function () {
                    var productoId = $(this).data('producto-id');
                    var cantidad = $(this).val();
                    var descripcion = $('.descripcion[data-producto-id="' + productoId + '"]').val();

                    if (cantidad) {
                        constataciones.push({
                            productoId: productoId,
                            cantidadFisica: parseInt(cantidad),
                            descripcion: descripcion
                        });
                    }
                });

                if (constataciones.length === 0) {
                    alert('Debe ingresar al menos una cantidad física');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GuardarConstatacion")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(constataciones),
                    success: function (response) {
                        if (response.success) {
                            alert('Constatación guardada exitosamente');
                            window.location.href = '@Url.Action("Index")';
                        } else {
                            alert('Error al guardar: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Error al guardar la constatación');
                    }
                });
            });
        });
    </script>
}