@model ContaFacil.Models.Persona

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>
<h4>Cliente</h4>
<hr />

<div class="form-container">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <!-- Primera Columna -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control uppercase-input" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Direccion" class="control-label">Dirección</label>
                    <input asp-for="Direccion" class="form-control uppercase-input" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Telefono" class="control-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" type="text" inputmode="numeric" pattern="\d*" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda Columna -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="IdTipoIdentificacion" class="control-label">Tipo de Identificación</label>
                    @if (ViewBag.TipoIdentificacionError != null)
                    {
                        <p class="text-danger">@ViewBag.TipoIdentificacionError</p>
                    }
                    else
                    {
                        @Html.DropDownListFor(m => m.IdTipoIdentificacion, (SelectList)ViewData["IdTipoIdentificacion"], "Seleccione un tipo", new { @class = "form-control" })
                    }
                    <span asp-validation-for="IdTipoIdentificacion" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Identificacion" class="control-label">Identificación</label>
                    <input asp-for="Identificacion" class="form-control" type="text" inputmode="numeric" pattern="\d*" />
                    <span asp-validation-for="Identificacion" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Botones centrados debajo de las columnas -->
        <div class="row mt-4">
            <div class="col-12 text-center">
                <button class="btn btn-primary me-2" type="submit">Crear</button>
                <a class="btn btn-secondary" asp-action="Index">Volver a la Lista</a>
            </div>
        </div>
    </form>
</div>

<style>
    .form-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .btn {
        min-width: 120px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $('#Identificacion, #Telefono').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            var uppercaseInputs = document.querySelectorAll('.uppercase-input');

            uppercaseInputs.forEach(function (input) {
                input.addEventListener('input', function () {
                    this.value = this.value.toUpperCase();
                });
            });

            document.querySelector('form').addEventListener('submit', function () {
                uppercaseInputs.forEach(function (input) {
                    input.value = input.value.toUpperCase();
                });
            });
        });

        $(document).ready(function () {
            $("#chkRetencionIva, #chkRetencionFuente").change(function () {
                var divId = this.id === "chkRetencionIva" ? "#divRetencionIva" : "#divRetencionFuente";
                $(divId).toggle(this.checked);
            });
        });
    </script>
}