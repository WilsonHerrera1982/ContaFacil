@model ContaFacil.Models.Persona

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Cliente</h4>
<div>
    <a asp-action="Index" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>

<div class="row">

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdPersona" />

            <div class="row">
                <!-- Columna izquierda -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Nombre" class="control-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Direccion" class="control-label">Dirección</label>
                        <input asp-for="Direccion" class="form-control" />
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Telefono" class="control-label">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" asp-for="Estado" />
                        <label class="form-check-label" asp-for="Estado">Activo/Inactivo</label>
                    </div>
                </div>

                <!-- Columna derecha -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Identificacion" class="control-label"></label>
                        <input asp-for="Identificacion" class="form-control" />
                        <span asp-validation-for="Identificacion" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="checkbox" id="chkRetencionIva" name="chkRetencionIva" />
                        <label for="chkRetencionIva">Retención IVA</label>
                    </div>
                    <div class="form-group" id="divRetencionIva" style="display:none;">
                        <label asp-for="RetencionIva" class="control-label"></label>
                        <select asp-for="RetencionIva" class="form-control" asp-items="@(new SelectList(ViewBag.IdImpuesto, "Value", "Text", 0))">
                            <option value="0">Seleccione una opción</option>
                        </select>
                        <span asp-validation-for="RetencionIva" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="checkbox" id="chkRetencionFuente" name="chkRetencionFuente" />
                        <label for="chkRetencionFuente">Retención en la Fuente</label>
                    </div>
                    <div class="form-group" id="divRetencionFuente" style="display:none;">
                        <label asp-for="RetencionPorcentaje" class="control-label"></label>
                        <select asp-for="RetencionPorcentaje" class="form-control" asp-items="@(new SelectList(ViewBag.IdRetencionF, "Value", "Text", 0))">
                            <option value="0">Seleccione una opción</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <center>
                    <button class="button" type="submit">Guardar</button>
                </center>
            </div>
        </form>

</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $("#chkRetencionIva").change(function () {
                if (this.checked) {
                    $("#divRetencionIva").show();
                } else {
                    $("#divRetencionIva").hide();
                }
            });

            $("#chkRetencionFuente").change(function () {
                if (this.checked) {
                    $("#divRetencionFuente").show();
                } else {
                    $("#divRetencionFuente").hide();
                }
            });
        });
    </script>
}
