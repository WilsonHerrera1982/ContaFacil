@model IEnumerable<ContaFacil.Models.Despacho>

@{
    ViewData["Title"] = "Index";
}


<div class="text-left mb-4">
    <h2>Crear Guía de Remisión</h2>
    <a asp-action="Create" asp-controller="Inventario">Crear Nuevo</a>
    <a asp-action="Index" asp-controller="Inventario" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.NumeroDespacho)</th>
            <th>@Html.DisplayNameFor(model => model.FechaCreacion)</th>
            <th>@Html.DisplayNameFor(model => model.EstadoDespacho)</th>
            <th>Sucursal de Destino</th>
            <th>Sucursal de Origen</th>
            <th>Usuario</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.NumeroDespacho)</td>
            <td>@Html.DisplayFor(modelItem => item.FechaCreacion)</td>
            <td>@Html.DisplayFor(modelItem => item.EstadoDespacho)</td>
            <td>@Html.DisplayFor(modelItem => item.NombreSucursalDestino)</td>
            <td>@Html.DisplayFor(modelItem => item.IdSucursalNavigation.NombreSucursal)</td>
            <td>@Html.DisplayFor(modelItem => item.IdUsuarioNavigation.IdPersonaNavigation.Nombre)</td>
            <td>
                @if (item.IdSucursalDestino == ViewBag.SucursalId && item.EstadoDespacho == "PENDIENTE")
                {
                    <form asp-action="AceptarDespacho" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.IdDespacho" />
                        <button type="submit" class="btn btn-primary"><i class="fas fa-angle-double-right"></i>Aceptar Despacho</button>
                    </form>
                }
                else
                {
                    @if (ViewBag.NombreSucursal.Equals("Matriz")) { 
                    <a asp-action="Edit" asp-route-id="@item.IdDespacho">Editar</a> <span>|</span>
                    }
                    <a asp-action="Details" asp-route-id="@item.IdDespacho">Detalles</a> <span>|</span>
                    @if (ViewBag.NombreSucursal.Equals("Matriz"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.IdDespacho">Borrar</a>
                    }
                }
            </td>
        </tr>
        <tr>
            <td colspan="7">
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>                            
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var detalle in item.DetalleDespachos)
                    {
                        <tr>
                                    <td>@detalle.IdProductoNavigation.Nombre @detalle.IdProductoNavigation.Descripcion</td>
                            <td>@detalle.Cantidad</td>
                                    <td>@(detalle.EstadoBoolean.GetValueOrDefault() ? "Activo" : "Inactivo")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </td>
        </tr>
    }
    </tbody>
</table>