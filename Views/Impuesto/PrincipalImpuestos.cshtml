@{
    ViewData["Title"] = "Principal Impuestos";
}

<style>
    .row {
        justify-content: center;
    }
</style>
<div class="text-left mb-4">
    <h2>Gestión de Impuestos</h2>
    <a asp-action="PrincipalFactura" asp-controller="Factura" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>
<div class="container mt-4">
    <div class="row row-cols-1 row-cols-md-2 g-4">
        <!-- IVA -->
        <div class="col">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-calculator fa-3x mb-3 text-danger"></i>
                    <h5 class="card-title">IVA</h5>
                    <p class="card-text">Gestiona IVA del sistema.</p>
                    <a asp-action="Iva" asp-controller="Impuesto" class="btn btn-danger mt-auto">Gestionar IVA</a>
                </div>
            </div>
        </div>

        <!-- Retenciones -->
        <div class="col">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-percent fa-3x mb-3 text-secondary"></i>
                    <h5 class="card-title">Retenciones</h5>
                    <p class="card-text">Gestiona las retenciones del sistema.</p>
                    <a asp-action="Index" asp-controller="Impuesto" class="btn btn-secondary mt-auto">Gestionar Retenciones</a>
                </div>
            </div>
        </div>
    </div>
</div>