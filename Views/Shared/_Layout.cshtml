@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using ContaFacil.Models
@{
    var menuJson = Context.Session.GetString("menu");
    List<Menu> menus = new List<Menu>();
    if (!string.IsNullOrEmpty(menuJson))
    {
        try
        {
            var jObject = JObject.Parse(menuJson);
            var values = jObject["$values"];
            if (values != null)
            {
                menus = values.ToObject<List<Menu>>();
            }
        }
        catch (JsonException ex)
        {
            Console.WriteLine($"Error al deserializar JSON: {ex.Message}");
        }
    }
}
@{
    var usuario = Context.Session.GetString("_usuario");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FINANSYS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/overlay.css" />
    <link rel="stylesheet" href="~/css/ui-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ContaFacil.styles.css" asp-append-version="true" />
    <link href="~/lib/limonte-sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <script src="~/lib/limonte-sweetalert2/sweetalert2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
</head>
<body>
    <header style="background: conic-gradient(from 0deg at 50% 50%, #1A3263, #64B5F6, #1A3263); width: 100%; min-height: 100px;">
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/Logo1sin fondo.png" alt="ContaFacil Logo" class="mr-2" style="height: 120px;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                   
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-icon-wrapper">
                                    <img src="~/img/user.png" alt="User Icon" class="user-icon">
                                </div>
                            </a>
                            <p class="user-name">Usuario: @usuario</p>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="#">Perfil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Login" asp-action="Logout">Cerrar Sesión</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0 d-flex">
        <!-- Barra lateral -->
        <div class="d-flex flex-column flex-shrink-0" style="background: conic-gradient(from 0deg at 50% 50%, #1A3263, #64B5F6, #1A3263); width: 200px; min-height: calc(100vh - 100px);">
            <div class="navbar-nav flex-grow-1 d-flex flex-column align-items-center">
                <style>
                    .nav-link {
                        font-size: 1.2rem !important; /* Aumenta el tamaño de la letra */
                        padding: 0.75rem 1rem !important; /* Aumenta el padding para mejor espaciado */
                    }

                    .dropdown-item {
                        font-size: 1.1rem !important; /* Aumenta el tamaño de la letra de los submenús */
                    }
                </style>
                @if (menus != null)
                {
                    @foreach (var menu in menus)
                    {
                        <div class="nav-item dropdown w-100 text-center">
                            @if (menu.subMenus != null && menu.subMenus.Any())
                            {
                                <a class="nav-link dropdown-toggle text-light" href="#" id="navbarDropdown_@menu.IdMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @menu.Descripcion
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown_@menu.IdMenu">
                                    @foreach (var subMenu in menu.subMenus)
                                    {
                                        <li><a class="dropdown-item" asp-controller="@subMenu.Controller" asp-action="@subMenu.Action">@subMenu.Descripcion</a></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <a class="nav-link text-light @(ViewContext.RouteData.Values["Controller"].ToString() == menu.Controller ? "active-menu" : "") w-100"
                                   asp-controller="@menu.Controller"
                                   asp-action="@menu.Action">@menu.Descripcion</a>
                            }
                        </div>
                    }
                }
            </div>
            
        </div>
        
        <!-- Contenido principal -->
        <div class="d-flex flex-column flex-grow-1 overflow-auto" style="min-height: calc(100vh - 100px);">
            <main role="main" class="p-3">
                    @Html.Partial("_NotificacionParcial")
                    @Html.Partial("_BreadcrumbsPartial")
                    <div class="page-transition-container">
                        @RenderBody()
                    </div>
                </main>
                <footer class="border-top footer text-muted mt-auto">
                    <div class="container text-center">
                        &copy; 2024 - ContaFacil - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </footer>
            </div>
            <div id="loaderOverlay" class="loader-overlay">
                <div class="loader-content">
                    <div class="spinner"></div>
                    <div>Procesando...</div>
                </div>
            </div>
        </div>
    </div>



    <link rel="stylesheet" href="~/css/dark-mode.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/overlay.js"></script>
    <script src="~/js/button-standardizer.js" asp-append-version="true"></script>
    <script src="~/js/ui-enhancements.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@section Scripts {
    <!-- Script para asegurar la disponibilidad de toggleLoader -->
    <script>
        (function () {
            console.log('Inicializando el loader y las interceptaciones globales...');
            let activeRequests = 0;
            const overlay = document.getElementById('loaderOverlay');

            // Función global para mostrar/ocultar el overlay
            function toggleLoader(show) {
                if (!overlay) {
                    console.error('Elemento #loaderOverlay no encontrado en el DOM.');
                    return;
                }

                if (show) {
                    activeRequests++;
                    overlay.style.display = 'block';
                } else {
                    activeRequests = Math.max(0, activeRequests - 1); // Evitar números negativos
                    if (activeRequests === 0) {
                        overlay.style.display = 'none';
                    }
                }

                console.log('Estado del loader:', { show, activeRequests });
            }

            // Registrar toggleLoader globalmente
            window.toggleLoader = toggleLoader;

            // Ocultar el loader al cargar la página
            document.addEventListener('DOMContentLoaded', function () {
                toggleLoader(false);
            });

            window.addEventListener('load', function () {
                toggleLoader(false);
            });

            // Manejar errores globales para ocultar el loader
            window.addEventListener('error', function () {
                toggleLoader(false);
            });

            // Interceptar todas las peticiones fetch
            const originalFetch = window.fetch;
            window.fetch = function (...args) {
                toggleLoader(true);
                return originalFetch.apply(this, args)
                    .finally(() => {
                        console.log('Cerrando loader después de fetch...');
                        toggleLoader(false);
                    });
            };

            // Interceptar todas las peticiones XMLHttpRequest
            const originalXHR = window.XMLHttpRequest;
            function newXHR() {
                const xhr = new originalXHR();
                xhr.addEventListener('loadstart', () => toggleLoader(true));
                xhr.addEventListener('loadend', () => toggleLoader(false));
                return xhr;
            }
            window.XMLHttpRequest = newXHR;

            // Interceptar peticiones jQuery si jQuery está presente
            if (window.jQuery) {
                jQuery(document).ajaxStart(() => toggleLoader(true));
                jQuery(document).ajaxStop(() => toggleLoader(false));
            }
        })();
    </script>

    <!-- Asegurar que el loader se oculte al cargar el DOM y los recursos -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log('DOM completamente cargado. Ocultando el loader...');
            toggleLoader(false);
        });

        window.addEventListener('load', function () {
            console.log('Recursos completamente cargados. Ocultando el loader...');
            toggleLoader(false);
        });
    </script>

    <!-- Scripts adicionales de la vista -->
    @await RenderSectionAsync("Scripts", required: false)
}
