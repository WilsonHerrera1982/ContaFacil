@{
    ViewData["Title"] = "Cargar Excel";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 480px;">
        <div class="text-center mb-4">
            <h2 class="mb-1" style="font-weight: 700; color: #1e386a;">Cargar archivo Excel</h2>
            <p class="text-muted mb-3">Utilice la matriz para cargar datos iniciales al sistema.</p>
            <div class="d-flex justify-content-center gap-2 mb-3">
                <a asp-action="Index" asp-controller="Inventario" class="btn btn-outline-primary d-inline-flex align-items-center">
                    <i class="fas fa-arrow-left me-2"></i> Regresar
                </a>
                <a asp-action="DescargarMatrizCargaInicial" asp-controller="Inventario" class="btn btn-success d-inline-flex align-items-center" data-download="true">
                    <i class="fas fa-file-excel me-2"></i> Descargar Matriz de Carga Inicial
                </a>
            </div>
        </div>
        <hr />
        <form asp-action="CargarExcel" method="post" enctype="multipart/form-data">
            <div class="mb-3 text-center">
                <label for="fileInput" class="form-label" style="font-weight: 500;">Selecciona un archivo Excel para cargar</label>
                <input type="file" id="fileInput" name="file" class="form-control mb-2" accept=".xlsx,.xls" />
            </div>
            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-upload me-2"></i> Cargar
                </button>
            </div>
        </form>
    </div>
</div>
