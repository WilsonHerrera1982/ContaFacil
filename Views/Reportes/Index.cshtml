@{
    ViewData["Title"] = "Reportes Contables";
     var opcionClientes = (List<OpcionCliente>
    )ViewBag.OpcionClientes;

    bool TienePermiso(string opcionNombre)
    {
        return opcionClientes?.Any(o => o.OpcionNombre.Trim().Equals(opcionNombre.Trim(),
        StringComparison.OrdinalIgnoreCase)) ?? false;
    }
}

<style>
    .card {
        height: 100%;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .btn {
        align-self: center;
    }

    .icon-size {
        font-size: 2.5rem;
    }
    .card.disabled {
        opacity: 0.7;
        pointer-events: none;
        position: relative;
    }

    .lock-icon {
        position: absolute;
        top: 10px;
        right: 10px;
        color: #dc3545;
        font-size: 1.2em;
        z-index: 1;
    }

</style>

<div class="container mt-4">
    <h2 class="mb-4">Reportes Contables</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <div class="col">
            <div class="card @(!TienePermiso("PLAN CUENTAS") ? "disabled" : "")">
                <div class="card-body text-center">
                                @if (!TienePermiso("PLAN CUENTAS"))
{
    <i class="fas fa-lock lock-icon"></i>
}
                    <i class="fas fa-book icon-size mb-3 text-primary"></i>
                    <h5 class="card-title">Plan de Cuentas</h5>
                    <p class="card-text">Genera el reporte del Plan de Cuentas.</p>
                    <a asp-action="Index" asp-controller="Cuentum" class="btn btn-primary mt-3">Generar Plan de Cuentas</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card @(!TienePermiso("LIBRO DIARIO") ? "disabled" : "")">
                <div class="card-body text-center">
                                @if (!TienePermiso("LIBRO DIARIO"))
{
    <i class="fas fa-lock lock-icon"></i>
}
                    <i class="fas fa-journal-whills icon-size mb-3 text-primary"></i>
                    <h5 class="card-title">Libro Diario</h5>
                    <p class="card-text">Genera el reporte del Libro Diario.</p>
                    <form asp-action="ExportarLibroDiarioExcel" method="post" data-download="true">
                        <div class="form-group">
                            <label for="fechaInicio">Fecha Inicio:</label>
                            <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label for="fechaFin">Fecha Fin:</label>
                            <input type="date" id="fechaFin" name="fechaFin" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Generar Libro Diario</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card @(!TienePermiso("MAYORIZACION") ? "disabled" : "")">
                <div class="card-body text-center">
                                @if (!TienePermiso("MAYORIZACION"))
{
    <i class="fas fa-lock lock-icon"></i>
}
                    <i class="fas fa-calculator icon-size mb-3 text-primary"></i>
                    <h5 class="card-title">Mayorización</h5>
                    <p class="card-text">Genera el reporte de Mayorización.</p>
                    <form asp-action="ExportarMayorizacionExcel" method="post" data-download="true">
                        <div class="form-group">
                            <label for="fechaInicioMay">Fecha Inicio:</label>
                            <input type="date" id="fechaInicioMay" name="fechaInicio" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label for="fechaFinMay">Fecha Fin:</label>
                            <input type="date" id="fechaFinMay" name="fechaFin" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Generar Mayorización</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card @(!TienePermiso("SITUACION FINANCIERA") ? "disabled" : "")">
                <div class="card-body text-center">
                                @if (!TienePermiso("SITUACION FINANCIERA"))
{
    <i class="fas fa-lock lock-icon"></i>
}
                    <i class="fas fa-balance-scale icon-size mb-3 text-primary"></i>
                    <h5 class="card-title">Estado de Situación Financiera</h5>
                    <p class="card-text">Genera el reporte de Estado Situación Financiera.</p>
                    <form asp-action="ExportarBalanceGeneralExcel" method="post" data-download="true">
                        <div class="form-group">
                            <label for="fechaInicioBal">Fecha Inicio:</label>
                            <input type="date" id="fechaInicioBal" name="fechaInicio" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label for="fechaFinBal">Fecha Fin:</label>
                            <input type="date" id="fechaFinBal" name="fechaFin" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Generar Estado de Situación Financiera</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card @(!TienePermiso("ESTADO RESULTADOS") ? "disabled" : "")">
                <div class="card-body text-center">
                                @if (!TienePermiso("ESTADO RESULTADOS"))
{
    <i class="fas fa-lock lock-icon"></i>
}
                    <i class="fas fa-chart-line icon-size mb-3 text-primary"></i>
                    <h5 class="card-title">Estado de Resultados</h5>
                    <p class="card-text">Genera el reporte de Estado de Resultados.</p>
                    <form asp-action="ExportEstadoExcel" method="post" data-download="true">
                        <div class="form-group">
                            <label for="fechaInicioEst">Fecha Inicio:</label>
                            <input type="date" id="fechaInicioEst" name="fechaInicio" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label for="fechaFinEst">Fecha Fin:</label>
                            <input type="date" id="fechaFinEst" name="fechaFin" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Generar Estado de Resultados</button>
                       
                    </form>
                </div>
                </div>
        </div>
    </div>
</div>

<!-- El overlay de loading se maneja desde el layout principal (_Layout.cshtml) -->

<script>
$(document).ready(function() {
    // Deshabilitar todos los botones submit de formularios con fechas al iniciar
    $('form').each(function() {
        var $form = $(this);
        var $fechaInicio = $form.find('input[type="date"][name="fechaInicio"]');
        var $fechaFin = $form.find('input[type="date"][name="fechaFin"]');
        var $submitBtn = $form.find('button[type="submit"]');
        if ($fechaInicio.length && $fechaFin.length) {
            $submitBtn.prop('disabled', true);
            function validarFechas() {
                if ($fechaInicio.val() && $fechaFin.val()) {
                    $submitBtn.prop('disabled', false);
                } else {
                    $submitBtn.prop('disabled', true);
                }
            }
            $fechaInicio.on('input change', validarFechas);
            $fechaFin.on('input change', validarFechas);
        }
    });
    // Variable para controlar el loading de descargas
    var downloadInProgress = false;
    var downloadTimeout;
    
    // Interceptar todos los envíos de formularios
    $('form').submit(function(e) {
        var $form = $(this);
        showLoading();
        
        // Para formularios de descarga, usar detección de focus
        if ($form.attr('data-download') === 'true') {
            var action = $form.attr('action') || '';
            downloadInProgress = true;
            
            console.log('Form action:', action); // Debug log
            console.log('Iniciando descarga, esperando regreso del focus...'); // Debug log
            
            // Para Estado de Resultados, forzar el uso del overlay temporal
            if (action.includes('ExportEstadoExcel')) {
                console.log('Estado de Resultados detectado - forzando overlay temporal'); // Debug log
                // Ocultar overlay principal si existe para evitar conflictos
                $('#loaderOverlay').hide();
                // Forzar creación del overlay temporal
                if ($('#temp-loading-overlay').length === 0) {
                    $('body').append('<div id="temp-loading-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;display:flex;justify-content:center;align-items:center;color:white;font-size:18px;">Procesando...</div>');
                }
                $('#temp-loading-overlay').show();
            }
            
            // Timeout de seguridad más corto
            downloadTimeout = setTimeout(function() {
                console.log('Timeout de seguridad alcanzado, ocultando loading'); // Debug log
                downloadInProgress = false;
                hideLoading();
            }, 5000); // 5 segundos máximo
        }
    });

    // Interceptar el clic en el botón de "Generar Plan de Cuentas"
    $('a[asp-action="Index"][asp-controller="Cuentum"]').click(function() {
        showLoading();
    });

    // Función para mostrar el indicador de carga (versión limpia)
    function showLoading() {
        // Siempre limpiar cualquier overlay previo antes de mostrar uno nuevo
        $('#loaderOverlay').hide(); // Ocultar overlay principal
        $('#temp-loading-overlay').remove(); // Eliminar overlay temporal
        
        // Intentar usar el overlay principal del layout primero
        var $loaderOverlay = $('#loaderOverlay');
        if ($loaderOverlay.length > 0) {
            $loaderOverlay.show();
        } else {
            // Fallback: crear un overlay simple si no existe el principal
            $('body').append('<div id="temp-loading-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;display:flex;justify-content:center;align-items:center;color:white;font-size:18px;">Procesando...</div>');
        }
    }

    // Función para ocultar el indicador de carga (versión limpia)
    function hideLoading() {
        // Ocultar overlay principal si existe
        var $loaderOverlay = $('#loaderOverlay');
        if ($loaderOverlay.length > 0) {
            $loaderOverlay.hide();
            $loaderOverlay.css('display', 'none');
        }
        
        // Ocultar overlay temporal si existe
        var $tempOverlay = $('#temp-loading-overlay');
        if ($tempOverlay.length > 0) {
            $tempOverlay.hide();
            $tempOverlay.remove();
        }
        // Forzar ocultamiento extra por compatibilidad, pero sin logs ni restauración
        setTimeout(function() {
            var principalCount = $('#loaderOverlay:visible').length;
            var tempCount = $('#temp-loading-overlay:visible').length;
            if (principalCount > 0) {
                var $stubborn = $('#loaderOverlay');
                $stubborn.hide().css({
                    'display': 'none !important',
                    'visibility': 'hidden !important',
                    'opacity': '0 !important',
                    'z-index': '-9999 !important',
                    'pointer-events': 'none !important'
                });
                $stubborn.removeClass('show').removeClass('active').removeClass('in');
                setTimeout(function() {
                    if ($('#loaderOverlay:visible').length > 0) {
                        $('#loaderOverlay').remove();
                    }
                }, 200);
            }
            if (tempCount > 0) {
                $('#temp-loading-overlay').remove();
            }
        }, 500);
    }

    // Detectar cuando el usuario regresa a la página después de una descarga
    $(window).on('focus', function() {
        if (downloadInProgress) {
            console.log('Focus regresado, descarga completada, ocultando loading'); // Debug log
            clearTimeout(downloadTimeout);
            downloadInProgress = false;
            hideLoading();
        }
    });
    
    // Ocultar el indicador de carga cuando la página termine de cargar
    $(window).on('load', function() {
        hideLoading();
    });

    // Opcional: Agregar un temporizador para ocultar el loading después de un tiempo máximo
    var loadingTimer;
    function showLoadingWithTimeout() {
        showLoading();
        clearTimeout(loadingTimer);
        loadingTimer = setTimeout(hideLoading, 20000); // 30 segundos de tiempo máximo
    }

    // Interceptar navegación del navegador
    $(window).on('beforeunload', function() {
        showLoading();
    });
});


</script>

<script>
    // En tu archivo JavaScript específico para la página de reportes
    $(document).ready(function () {
        function cargarReportes() {
            $.ajax({
                url: 'https://localhost:7072/Reportes/Index',
                method: 'GET',
                dataType: 'json', // Especifica que esperas JSON
                beforeSend: function () {
                    console.log('Iniciando petición...');
                },
                success: function (data) {
                    console.log('Datos recibidos:', data);
                    // Aquí procesas los datos
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    // Aquí manejas el error
                }
            });
        }

        // Si tienes un botón para cargar
        $('#btnCargar').on('click', cargarReportes);
    });
    $('.card.disabled a').on('click', function (e) {
                e.preventDefault();
                return false;
            });
</script>