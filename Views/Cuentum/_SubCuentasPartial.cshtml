@using ContaFacil.Models.ViewModel
@model SubCuentasPartialViewModel

@foreach (var subcuenta in Model.Cuentas.Where(c => c.IdIdCuenta == Model.ParentId && c.Estado == true))
{
    <div class="cuenta-hijo @(subcuenta.IdIdCuenta != null ? "cuenta-nieto" : "")">
        <div class="d-flex justify-content-between align-items-center">
            <div class="cuenta-info">
                <h6 class="mb-2">
                    <i class="fas fa-file-alt me-2"></i>
                    @subcuenta.Codigo - @subcuenta.Nombre
                </h6>
                <div class="form-check-group ms-4">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"
                               id="debito_@subcuenta.IdCuenta"
                        @(subcuenta.Debito.GetValueOrDefault() ? "checked" : "")
                               disabled>
                        <label class="form-check-label" for="debito_@subcuenta.IdCuenta">
                            Débito
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"
                               id="credito_@subcuenta.IdCuenta"
                        @(subcuenta.Credito.GetValueOrDefault() ? "checked" : "")
                               disabled>
                        <label class="form-check-label" for="credito_@subcuenta.IdCuenta">
                            Crédito
                        </label>
                    </div>
                </div>
            </div>
            <div class="btn-group">
                <a href="@Url.Action("Edit", "Cuentum", new { id = subcuenta.IdCuenta })"
                   class="btn btn-sm btn-warning me-2">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <button onclick="showAddDialog('@subcuenta.IdCuenta', '@subcuenta.Codigo', '@subcuenta.Nombre')"
                        class="btn btn-sm btn-success">
                    <i class="fas fa-plus"></i> Agregar subcuenta
                </button>
            </div>
        </div>
        @await Html.PartialAsync("_SubCuentasPartial", new SubCuentasPartialViewModel { Cuentas = Model.Cuentas, ParentId = subcuenta.IdCuenta })
    </div>
}