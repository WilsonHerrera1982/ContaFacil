@model ContaFacil.Models.Cuentum
@{
    ViewData["Title"] = "Edit";
}
<h1>Editar</h1>
<h4>Cuenta</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdCuenta" />

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input"
                       id="Credito" name="Credito"
                @(Model.Credito == true ? "checked" : "") />
                <label class="form-check-label" for="Credito">Crédito</label>
            </div>

            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input"
                       id="Debito" name="Debito"
                @(Model.Debito == true ? "checked" : "") />
                <label class="form-check-label" for="Debito">Débito</label>
            </div>

            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input"
                       id="Estado" name="Estado"
                @(Model.Estado == true ? "checked" : "") />
                <label class="form-check-label" for="Estado">Activo/Inactivo</label>
            </div>

            <div class="form-group text-center">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Regresar a la Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}