@model ContaFacil.Models.CuentasPorPagar
@using ContaFacil.Models.Enum

@{
    ViewData["Title"] = "Cuentas por Pagar - Crear";
    var tiposDocumento = Enum.GetValues(typeof(TipoDocumento)).Cast<TipoDocumento>();
    var tiposProveedor = Enum.GetValues(typeof(TipoProveedor)).Cast<TipoProveedor>();
    var formasPago = Enum.GetValues(typeof(FormaPagoEnum)).Cast<FormaPagoEnum>();
    var estados = Enum.GetValues(typeof(EstadoPagoEnum)).Cast<EstadoPagoEnum>();
}

<h1>Crear Cuenta por Pagar</h1>
<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="TipoDocumento" class="control-label">Tipo de Documento</label>
                        <select asp-for="TipoDocumento" class="form-control" asp-items="@(new SelectList(tiposDocumento))">
                            <option value="">Seleccionar Tipo de Documento</option>
                        </select>
                        <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TipoProveedor" class="control-label">Tipo de Proveedor</label>
                        <select asp-for="TipoProveedor" class="form-control" asp-items="@(new SelectList(tiposProveedor))">
                            <option value="">Seleccionar Tipo de Proveedor</option>
                        </select>
                        <span asp-validation-for="TipoProveedor" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RazonSocial" class="control-label">Razón Social</label>
                        <input asp-for="RazonSocial" class="form-control" />
                        <span asp-validation-for="RazonSocial" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RucIdentificacion" class="control-label">RUC/Identificación</label>
                        <input asp-for="RucIdentificacion" class="form-control" />
                        <span asp-validation-for="RucIdentificacion" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="NumeroDocumento" class="control-label">Número de Documento</label>
                        <input asp-for="NumeroDocumento" class="form-control" />
                        <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FechaEmision" class="control-label">Fecha de Emisión</label>
                        <input asp-for="FechaEmision" type="date" class="form-control" />
                        <span asp-validation-for="FechaEmision" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FechaVencimiento" class="control-label">Fecha de Vencimiento</label>
                        <input asp-for="FechaVencimiento" type="date" class="form-control" />
                        <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MontoTotal" class="control-label">Monto Total</label>
                        <input asp-for="MontoTotal" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="MontoTotal" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MontoPendiente" class="control-label">Monto Pendiente</label>
                        <input asp-for="MontoPendiente" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="MontoPendiente" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FormaPago" class="control-label">Forma de Pago</label>
                        <select asp-for="FormaPago" class="form-control" asp-items="@(new SelectList(formasPago))">
                            <option value="">Seleccionar Forma de Pago</option>
                        </select>
                        <span asp-validation-for="FormaPago" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="NumeroReferencia" class="control-label">Número de Referencia</label>
                        <input asp-for="NumeroReferencia" class="form-control" />
                        <span asp-validation-for="NumeroReferencia" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Estado" class="control-label">Estado Pago</label>
                        <select asp-for="Estado" class="form-control" asp-items="@(new SelectList(estados))">
                            <option value="">Seleccionar estado pago</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ml-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}