@model IEnumerable<ContaFacil.Models.OpcionesCliente>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaCreacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Empresa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaCreacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Empresa.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opcion.OpcionNombre)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OpcId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OpcId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OpcId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
