@model ContaFacil.Models.AnticipoCuentum
@{
    ViewData["Title"] = "Crear Anticipo";
}

    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            padding: 5px;
        }

        .select2-container--default .select2-selection--single {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }
    </style>

<h1>Crear Anticipo</h1>
<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Create" id="anticipoForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdCuenta" class="control-label">Cuenta por Pagar</label>
                        <div class="input-group">
                            <select asp-for="IdCuenta"
                                    class="form-control select2"
                                    asp-items="ViewBag.IdCuenta"
                                    id="cuentaSelect">
                                <option value="">Buscar Cuenta por Descripción</option>
                            </select>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-secondary" id="buscarCuenta">Buscar</button>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Número de Documento</label>
                        <input type="text" class="form-control" id="numeroDocumento" readonly />
                    </div>

                    <div class="form-group">
                        <label>Monto Total</label>
                        <input type="text" class="form-control" id="montoTotal" readonly />
                    </div>

                    <div class="form-group">
                        <label>Monto Pendiente</label>
                        <input type="text" class="form-control" id="montoPendiente" readonly />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdAnticipo" class="control-label">Anticipo</label>
                        <select asp-for="IdAnticipo"
                                class="form-control"
                                asp-items="ViewBag.IdAnticipo">
                            <option value="">Seleccionar Anticipo</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label asp-for="Valor" class="control-label">Valor del Anticipo</label>
                        <input asp-for="Valor" class="form-control" id="valorAnticipo" />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FechaModificacion" class="control-label">Fecha de Modificación</label>
                        <input asp-for="FechaModificacion" type="date" class="form-control" />
                        <span asp-validation-for="FechaModificacion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ml-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize Select2 for searchable dropdown
            $('.select2').select2();

            // Agregar console.log para debugging
            $('#buscarCuenta').on('click', function () {
                console.log('Botón buscar clickeado');

                var selectedCuentaId = $('#cuentaSelect').val();
                console.log('ID de cuenta seleccionada:', selectedCuentaId);

                if (!selectedCuentaId) {
                    alert('Por favor seleccione una cuenta primero');
                    return;
                }

                // Mostrar indicador de carga
                $('#buscarCuenta').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Buscando...');

                $.ajax({
                    url: '/AnticipoCuentums/GetCuentaDetails',  // URL explícita como respaldo
                    type: 'GET',
                    data: { id: selectedCuentaId },
                    dataType: 'json',
                    success: function (data) {
                        console.log('Datos recibidos:', data);

                        if (data) {
                            $('#numeroDocumento').val(data.numeroDocumento || '');
                            $('#montoTotal').val(data.montoTotal ? data.montoTotal.toFixed(2) : '0.00');
                            $('#montoPendiente').val(data.montoPendiente ? data.montoPendiente.toFixed(2) : '0.00');

                            // Configurar validación del valor del anticipo
                            if (data.montoPendiente) {
                                $('#valorAnticipo').attr('max', data.montoPendiente);
                            }
                        } else {
                            alert('No se encontraron datos para la cuenta seleccionada');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error en la llamada AJAX:', error);
                        console.error('Status:', status);
                        console.error('Response:', xhr.responseText);
                        alert('Error al cargar los detalles de la cuenta: ' + error);
                    },
                    complete: function () {
                        // Restaurar el botón
                        $('#buscarCuenta').prop('disabled', false).html('Buscar');
                    }
                });
            });

            // Validación del valor del anticipo
            $('#valorAnticipo').on('input', function () {
                var valor = parseFloat($(this).val()) || 0;
                var montoPendiente = parseFloat($('#montoPendiente').val()) || 0;

                if (valor > montoPendiente) {
                    $(this).addClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                    $(this).after('<div class="invalid-feedback">El valor no puede ser mayor al monto pendiente</div>');
                } else {
                    $(this).removeClass('is-invalid');
                    $(this).next('.invalid-feedback').remove();
                }
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}