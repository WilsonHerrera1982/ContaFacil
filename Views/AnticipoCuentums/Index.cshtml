@model IEnumerable<ContaFacil.Models.AnticipoCuentum>

@{
    ViewData["Title"] = "Index";
}


<div class="text-left mb-4">
    <h2>Gestionar Anticipos</h2>
    <a asp-action="Create">Crear Nuevo</a>
    <a asp-action="PrincipalProveedor" asp-controller="Proveedor" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoBoolean)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaCreacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioCreacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdAnticipoNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdCuentaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Valor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoBoolean)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaCreacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaModificacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioCreacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsuarioModificacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdAnticipoNavigation.IdAnticipo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdCuentaNavigation.IdCuentaCobrar)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdAnticipoCuenta">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdAnticipoCuenta">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdAnticipoCuenta">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
