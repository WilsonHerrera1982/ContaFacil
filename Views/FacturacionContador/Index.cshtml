@using ContaFacil.Models.ViewModel
@model FacturacionContadorViewModel
@{
    ViewData["Title"] = "Index";
}

<p>
      <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 mb-2" style="padding: 8px 16px; border-radius: 4px;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
          <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13A6 6 0 1 1 8 2a6 6 0 0 1 0 12z"/>
          <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
      </svg>
      Crear Nuevo
  </a>
</p>
<form id="filtroForm" asp-action="Index" method="get" class="mb-3">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label class="sr-only" for="IdEmisor">Emisor</label>
            <select id="IdEmisor" name="IdEmisor" class="form-control" asp-for="SelectedEmisorId" asp-items="Model.Emisores">
                <option value="">-- Seleccione un emisor --</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Facturas.First().Fecha)
            </th>
            <th>
                Monto Total
            </th>
            <th>
                Estado SRI
            </th>
            <th>
                Descripción SRI
            </th>
            <th>
                Estado
            </th>
            <th>
                Cliente
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Facturas)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Fecha)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MontoTotal)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Estado)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DescripcionSri)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EstadoBoolean)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IdEmisorNavigation.RazonSocial)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdFactura">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdFactura">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdFactura">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>