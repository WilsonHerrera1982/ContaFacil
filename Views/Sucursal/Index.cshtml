@model IEnumerable<ContaFacil.Models.Sucursal>

@{
    ViewData["Title"] = "Index";
}




<div class="text-left mb-4">
    <h2>Gestionar Sucursales</h2>
    @if (ViewBag.mensaje == null)
    {
        <p>
            <a asp-action="Create">Crear Nuevo</a>
        </p>
    }
    else
    {
        <p>
            <span style="color:blue">@ViewBag.mesaje</span>
        </p>
    }
    <a asp-action="PrincipalSucursal" asp-controller="Sucursal" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreSucursal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Clave)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DireccionSucursal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuntoEmision)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Secuencial)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoBoolean)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NombreSucursal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usuario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Clave)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DireccionSucursal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PuntoEmision)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Secuencial)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoBoolean)
            </td>
          
            <td>
                    @if(!item.NombreSucursal.Equals("Matriz")){
                        <a asp-action="Edit" asp-route-id="@item.IdSucursal">Editar</a> <span> | </span>
                    }
                <a asp-action="Details" asp-route-id="@item.IdSucursal">Detalles</a> |
                    @if (!item.NombreSucursal.Equals("Matriz"))
                    {
                <a asp-action="Delete" asp-route-id="@item.IdSucursal">Borrar</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
