@model ContaFacil.Models.Sucursal

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Sucursal</h4>
<div>
    <a asp-action="Index" class="btn d-inline-flex align-items-center gap-2" style="background-color: #1e386a; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; transition: opacity 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
        </svg>
        Regresar
    </a>
</div>
<div class="row">
    <form asp-action="Edit" class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdSucursal" />

        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="NombreSucursal" class="control-label"></label>
                <input asp-for="NombreSucursal" class="form-control" />
                <span asp-validation-for="NombreSucursal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Usuario" class="control-label"></label>
                <input asp-for="Usuario" class="form-control" />
                <span asp-validation-for="Usuario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Clave" class="control-label"></label>
                <input asp-for="Clave" class="form-control" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>
            <div class="form-group form-check mt-4">
                <input type="checkbox" class="form-check-input" asp-for="EstadoBoolean" />
                <label class="form-check-label" asp-for="EstadoBoolean">Activo/Inactivo</label>
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="DireccionSucursal" class="control-label"></label>
                <input asp-for="DireccionSucursal" class="form-control" />
                <span asp-validation-for="DireccionSucursal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Telefono" class="control-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PuntoEmision" class="control-label"></label>
                <input asp-for="PuntoEmision" class="form-control" />
                <span asp-validation-for="PuntoEmision" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Secuencial" class="control-label"></label>
                <input asp-for="Secuencial" class="form-control" />
                <span asp-validation-for="Secuencial" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 mt-3">
            <input type="submit" value="Guardar" class="btn btn-primary" />
        </div>
    </form>
</div>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
